# =============================================================================
# English Learning Platform - Environment Variables Template
# Copy this file to .env (do not commit .env with production credentials)
# =============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL 16 in WSL/Docker)
# Note: Existing Docker container 'postgres' runs with user 'postgres' on port 5432.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=english_learning_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Application Timezone
APP_TIMEZONE=UTC

# Backend reads backend/.env when launched from backend/, not this root file.
# Initial admin is created only when app_user is empty. Choose a password locally
# or run scripts/initialize-admin.ps1. Existing accounts are never reset.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
