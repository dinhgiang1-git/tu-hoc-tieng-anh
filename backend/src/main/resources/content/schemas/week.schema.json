{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://englishlearning.vn/schemas/week.schema.json",
  "title": "CurriculumWeekSchema",
  "description": "JSON Schema xác thực nội dung một tuần học trong giáo trình",
  "type": "object",
  "required": [
    "key",
    "title",
    "weekNumber",
    "orderIndex",
    "description",
    "lessons"
  ],
  "properties": {
    "key": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
    "title": { "type": "string", "minLength": 3 },
    "weekNumber": { "type": "integer", "minimum": 1 },
    "orderIndex": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "minLength": 10 },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "title",
          "orderIndex",
          "estimatedMinutes",
          "required",
          "contentFile",
          "activities"
        ],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
          "title": { "type": "string", "minLength": 3 },
          "orderIndex": { "type": "integer", "minimum": 1 },
          "estimatedMinutes": { "type": "integer", "minimum": 5, "maximum": 180 },
          "required": { "type": "boolean" },
          "contentFile": { "type": "string", "pattern": "^lessons/[a-zA-Z0-9/_.-]+\\.md$" },
          "activities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "key",
                "title",
                "type",
                "required",
                "completionPolicy",
                "instructions"
              ],
              "properties": {
                "key": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
                "title": { "type": "string", "minLength": 3 },
                "type": {
                  "type": "string",
                  "enum": [
                    "READING",
                    "EXTERNAL_RESOURCE",
                    "PRACTICE",
                    "REFLECTION",
                    "QUIZ",
                    "DICTATION",
                    "RECORDING"
                  ]
                },
                "required": { "type": "boolean" },
                "completionPolicy": {
                  "type": "string",
                  "enum": [
                    "MANUAL_CHECK",
                    "MANUAL_CHECK_WITH_RESPONSE",
                    "RESPONSE_SUBMIT",
                    "ON_SUBMIT",
                    "PASS_SCORE"
                  ]
                },
                "resourceKeys": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "instructions": { "type": "string", "minLength": 5 },
                "skillTags": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "quizQuestions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["prompt", "options"],
                    "properties": {
                      "orderIndex": { "type": "integer" },
                      "prompt": { "type": "string", "minLength": 3 },
                      "explanation": { "type": "string" },
                      "options": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "type": "object",
                          "required": ["content", "isCorrect"],
                          "properties": {
                            "orderIndex": { "type": "integer" },
                            "content": { "type": "string", "minLength": 1 },
                            "isCorrect": { "type": "boolean" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
