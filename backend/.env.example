# =============================================================================
# English Learning Platform - Backend Environment Variables Template
# =============================================================================

SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=english_learning_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

APP_TIMEZONE=UTC

# Initial admin: created only when app_user is empty. Choose a password locally
# or run ../scripts/initialize-admin.ps1. Existing accounts are never reset.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
